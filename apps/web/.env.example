# Copy to .env.local for development. Never commit .env.local.

# ---------------------------------------------------------------------------
# SERVER-ONLY. No NEXT_PUBLIC_ prefix, so these cannot reach the browser
# bundle. The browser only ever talks to /api/* on this origin.
# ---------------------------------------------------------------------------

# Internal address of the FastAPI service (apps/api).
API_BASE_URL=http://127.0.0.1:8000

# Upstream timeout in ms. Raise it if the backend is on a free tier that sleeps
# — a cold start can take tens of seconds.
API_TIMEOUT_MS=15000

# Optional shared secret, sent as `Authorization: Bearer`. Set it if the
# backend is reachable from the public internet rather than a private network.
# API_INTERNAL_TOKEN=

# ---------------------------------------------------------------------------
# PUBLIC. Inlined into the client bundle at build time — never put a secret
# behind a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Canonical origin. Drives canonical URLs, OG tags, sitemap and robots, so it
# must be the real production origin in production or the SEO metadata will
# point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
