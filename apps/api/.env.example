# Copy to .env for local development. Never commit .env.
#
# The service boots fine with none of these set: OpenAI counting is offline and
# needs no key, and Claude/Gemini degrade to a clearly-marked estimate.

ENV=development
LOG_LEVEL=INFO

# Comma-separated. Must include the frontend origin or the browser blocks every
# request — this is the most common cause of "works locally, fails deployed".
CORS_ORIGINS=http://localhost:3000

# Optional. Enables exact (not estimated) counts for these providers.
# Both endpoints are free of token charges but are keyed and rate-limited.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Optional. Falls back to an in-process cache when unset — fine for one
# instance, not fine once the backend scales horizontally.
# REDIS_URL=redis://localhost:6379/0

CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=60
MAX_TEXT_BYTES=400000
